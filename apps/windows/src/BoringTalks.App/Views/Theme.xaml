<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:BoringTalks.App.Views">
  <!-- BoringTalks colours (apps/web/src/app/globals.css). -->
  <Color x:Key="InkColor">#292133</Color>
  <Color x:Key="InkSoftColor">#5B5470</Color>
  <Color x:Key="CallColor">#5B67F5</Color>
  <Color x:Key="CallDeepColor">#3845DB</Color>
  <Color x:Key="CallLightColor">#C9CDFF</Color>
  <Color x:Key="PaperColor">#EEF0FF</Color>
  <Color x:Key="SunSoftColor">#FFF1BF</Color>
  <Color x:Key="DangerColor">#E0323F</Color>
  <Color x:Key="DangerSoftColor">#FFE0E2</Color>
  <Color x:Key="MintColor">#2DB3A3</Color>

  <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="InkSoft" Color="{StaticResource InkSoftColor}" />
  <SolidColorBrush x:Key="Call" Color="{StaticResource CallColor}" />
  <SolidColorBrush x:Key="CallDeep" Color="{StaticResource CallDeepColor}" />
  <SolidColorBrush x:Key="CallLight" Color="{StaticResource CallLightColor}" />
  <SolidColorBrush x:Key="Paper" Color="{StaticResource PaperColor}" />
  <SolidColorBrush x:Key="SunSoft" Color="{StaticResource SunSoftColor}" />
  <SolidColorBrush x:Key="Danger" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSoft" Color="{StaticResource DangerSoftColor}" />
  <SolidColorBrush x:Key="Mint" Color="{StaticResource MintColor}" />
  <SolidColorBrush x:Key="Orange" Color="#C2620E" />
  <SolidColorBrush x:Key="Hairline" Color="#1F292133" />

  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

  <v:VisibleWhenConverter x:Key="VisibleWhen" />
  <v:HiddenWhenConverter x:Key="HiddenWhen" />
  <v:EqualsConverter x:Key="Equals" />

  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Heading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
  </Style>

  <!-- Buttons: rounded, flat, the brand's periwinkle for the main action. -->
  <Style x:Key="ButtonBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#33292133" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Box" Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource ButtonBase}" />
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource Call}" />
    <Setter Property="BorderBrush" Value="{StaticResource CallDeep}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource Primary}">
    <Setter Property="Background" Value="{StaticResource Danger}" />
    <Setter Property="BorderBrush" Value="#B5222D" />
  </Style>
  <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="Foreground" Value="{StaticResource CallDeep}" />
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="6,5" />
    <Setter Property="BorderBrush" Value="#40292133" />
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="6,4" />
  </Style>

  <!-- A tinted box for notices (countdown, call offer). -->
  <Style x:Key="Notice" TargetType="Border">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,8,0,0" />
  </Style>
</ResourceDictionary>
