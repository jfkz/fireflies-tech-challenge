<Window x:Class="BoringTalks.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BoringTalks Settings" Width="540" SizeToContent="Height" MaxHeight="900" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource Ink}" Background="#FAFAFE" Icon="/Assets/BoringTalks.ico">
  <Window.Resources>
    <Style x:Key="Group" TargetType="Border">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#1F292133" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style x:Key="Help" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="Margin" Value="0,2,0,10" />
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">

      <TextBlock Text="Speech model" Style="{StaticResource Heading}" Margin="0,0,0,6" />
      <Border Style="{StaticResource Group}">
        <StackPanel>
          <DockPanel>
            <TextBlock Text="Status" Width="150" />
            <TextBlock Text="{Binding App.ModelSummary}" TextWrapping="Wrap" />
          </DockPanel>
          <ProgressBar Height="4" Margin="0,8,0,0" Maximum="1" Value="{Binding ModelFraction, Mode=OneWay, TargetNullValue=0}"
                       IsIndeterminate="{Binding ModelIndeterminate, Mode=OneWay}"
                       Visibility="{Binding ModelLoading, Converter={StaticResource VisibleWhen}}" />
          <Button Content="Try downloading again" HorizontalAlignment="Left" Margin="0,8,0,0" Click="RetryModels_Click"
                  Visibility="{Binding ModelFailed, Converter={StaticResource VisibleWhen}}" />
          <DockPanel Margin="0,10,0,0">
            <TextBlock Text="Language" Width="150" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code"
                      SelectedValue="{Binding Language}" />
          </DockPanel>
          <TextBlock Style="{StaticResource Help}" Margin="0,8,0,0"
                     Text="Transcription runs on this PC (Parakeet v3, 25 European languages). Nothing is sent to a speech service." />
        </StackPanel>
      </Border>

      <TextBlock Text="Audio" Style="{StaticResource Heading}" Margin="0,0,0,6" />
      <Border Style="{StaticResource Group}">
        <StackPanel>
          <CheckBox Content="Keep Bluetooth headsets in high quality" IsChecked="{Binding AvoidBluetoothMic}" />
          <TextBlock Style="{StaticResource Help}"
                     Text="Recording with a Bluetooth headset's microphone switches the headset to call quality. With this on, “You” is recorded with the PC's own microphone instead." />
          <CheckBox Content="Upload meeting audio" IsChecked="{Binding UploadAudio}" />
          <TextBlock Style="{StaticResource Help}"
                     Text="Lets the dashboard play the meeting back. Without a local transcript the audio is uploaded anyway, so the server can transcribe it." />
          <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Keep recordings on this PC" Width="200" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding KeepChoices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding KeepAudioDays}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Text="Stop after silence" Width="200" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding SilenceChoices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SilenceStopMinutes}" />
          </DockPanel>
          <TextBlock Style="{StaticResource Help}" Margin="0,8,0,10"
                     Text="A meeting left recording after everyone has gone stops by itself when nobody has spoken for this long, and uploads as usual. A minute before, BoringTalks asks if you're still there." />
          <Button Content="Show recordings in Explorer" HorizontalAlignment="Left" Click="ShowRecordings_Click" />
        </StackPanel>
      </Border>

      <TextBlock Text="Calls" Style="{StaticResource Heading}" Margin="0,0,0,6" />
      <Border Style="{StaticResource Group}">
        <StackPanel>
          <CheckBox Content="Offer to record when a call starts" IsChecked="{Binding OfferToRecordCalls}" />
          <TextBlock Style="{StaticResource Help}"
                     Text="When Zoom, Teams, Webex, Slack, Discord or a browser has been using the microphone for a few seconds, BoringTalks asks whether to record. It only sees which app uses the microphone, never what it hears, and never records without asking." />
          <CheckBox Content="Stop when the call ends" IsChecked="{Binding StopWhenCallEnds}" />
          <TextBlock Style="{StaticResource Help}"
                     Text="When the app of the call being recorded stops using the microphone, the recording stops 30 seconds after the others go quiet." />
          <ItemsControl ItemsSource="{Binding IgnoredApps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,2">
                  <Button DockPanel.Dock="Right" Content="Ask again" Padding="8,3" Tag="{Binding}" Click="AskAgain_Click" />
                  <TextBlock Text="{Binding StringFormat=Never asked for {0}}" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <CheckBox Content="Open BoringTalks when I sign in to Windows" IsChecked="{Binding OpenAtSignIn}" Margin="0,6,0,0" />
          <TextBlock Style="{StaticResource Help}" Text="It waits in the system tray, so it can offer to record your calls." />
        </StackPanel>
      </Border>

      <TextBlock Text="Account" Style="{StaticResource Heading}" Margin="0,0,0,6" />
      <Border Style="{StaticResource Group}">
        <StackPanel>
          <StackPanel Visibility="{Binding App.Auth, Converter={StaticResource VisibleWhen}, ConverterParameter=SignedIn}">
            <DockPanel Margin="0,0,0,4">
              <TextBlock Text="Signed in as" Width="150" />
              <TextBlock Text="{Binding App.Email, TargetNullValue=—}" />
            </DockPanel>
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="This PC" Width="150" />
              <TextBlock Text="{Binding DeviceName}" />
            </DockPanel>
            <Button Style="{StaticResource DangerButton}" Content="Sign out" HorizontalAlignment="Left" Click="SignOut_Click" />
          </StackPanel>
          <Button Style="{StaticResource Primary}" Content="Sign in with browser" HorizontalAlignment="Left" Click="SignIn_Click"
                  Visibility="{Binding App.Auth, Converter={StaticResource HiddenWhen}, ConverterParameter=SignedIn}" />
          <DockPanel Margin="0,10,0,2">
            <TextBlock Text="API" Width="150" Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding App.Config.ApiUrl}" Style="{StaticResource Caption}" />
          </DockPanel>
          <DockPanel>
            <TextBlock Text="Dashboard" Width="150" Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding App.Config.WebUrl}" Style="{StaticResource Caption}" />
          </DockPanel>
        </StackPanel>
      </Border>

      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Quit BoringTalks" Click="Quit_Click" />
        <TextBlock Text="{Binding VersionText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
      </DockPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
