<Project>
  <PropertyGroup>
    <!-- The app version; release.ps1 reads it and the installer, latest-windows.json and the About text use it. -->
    <Version>0.5.0</Version>
    <Authors>BoringTalks</Authors>
    <Product>BoringTalks</Product>
    <Copyright>BoringTalks</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- Missing XML docs on public members, and CA rules that don't fit an app: noise. -->
    <NoWarn>$(NoWarn);CS1591;CA1002;CA1031;CA1034;CA1062;CA1303;CA1305;CA1307;CA1308;CA1309;CA1711;CA1310;CA1311;CA1716;CA1724;CA1805;CA1812;CA1819;CA1822;CA1848;CA1849;CA1859;CA1860;CA1861;CA1863;CA1869;CA2007;CA2227;CA5394</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
</Project>
