# --- runtime ---
NODE_ENV=development            # development | test | production
PORT=4000                       # Railway sets this
LOG_LEVEL=info                  # trace | debug | info | warn | error
APP_VERSION=0.1.0               # shown by GET /health
GIT_SHA=unknown                 # shown by GET /health

# --- data ---
DATABASE_URL=postgres://boringtalks:boringtalks@localhost:55433/boringtalks
REDIS_URL=redis://localhost:6480
QUEUE_PREFIX=bt                 # BullMQ key prefix; keeps environments sharing a Redis apart

# --- web ---
WEB_URL=http://localhost:3000   # links in emails
WEB_ORIGINS=http://localhost:3000   # CORS allow-list, comma-separated

# --- auth ---
FIREBASE_PROJECT_ID=boringtalks
# Dev/test only, ignored when NODE_ENV=production: accept unsigned Auth emulator tokens.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- storage: Cloudflare R2 (S3 API); MinIO from docker-compose locally ---
R2_ENDPOINT=http://localhost:9100   # R2: https://<accountid>.r2.cloudflarestorage.com
# R2_PUBLIC_ENDPOINT=               # optional: host used in presigned URLs if browsers reach storage elsewhere
R2_ACCESS_KEY_ID=boringtalks
R2_SECRET_ACCESS_KEY=boringtalks-secret
R2_BUCKET=boringtalks                # one bucket for every environment
R2_KEY_PREFIX=dev/                   # prod/ on production, dev/ on dev
R2_REGION=auto
DOWNLOADS_BASE_URL=https://download.boringtalks.lol   # serves the bucket's downloads/ folder (latest.json + DMGs)

# --- AI (Vercel AI Gateway) ---
AI_GATEWAY_API_KEY=
SUMMARY_MODEL=anthropic/claude-haiku-4.5
TRANSCRIBE_MODEL=openai/whisper-1
SUMMARIZE_CONCURRENCY=4         # parallel LLM calls per worker replica
TRANSCRIBE_CONCURRENCY=2
# AI_FAKE=1                     # tests only: fake summarizer, transcriber and email sender

# --- email (Resend) ---
RESEND_API_KEY=                 # empty: emails are logged instead of sent
EMAIL_FROM=BoringTalks <hello@send.boringtalks.lol>
EMAIL_ALLOWLIST=                # comma-separated; when set, only these addresses get email (dev env)

# --- limits ---
THROTTLE_LIMIT=120              # requests per minute per user (or IP when signed out)
