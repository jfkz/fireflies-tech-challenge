# BoringTalks API (no trailing slash).
# prod https://api.boringtalks.lol · dev https://api.dev.boringtalks.lol · local http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Firebase web app config (Project settings → Your apps → Web app).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=boringtalks.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=boringtalks
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: use the local Firebase Auth emulator instead (e2e uses this).
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099

# Public site URL, used for metadata / OG tags.
NEXT_PUBLIC_SITE_URL=https://boringtalks.lol
